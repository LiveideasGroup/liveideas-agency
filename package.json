{
  "name": "liveideas-agency",
  "version": "1.0.0",
  "description": "Agent-run AI consultancy: CEO, Research and Sales agents plus a live owner dashboard",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/src/index.ts",
    "agent": "tsx worker/src/index.ts once",
    "typecheck": "tsc --noEmit",
    "security": "tsx worker/src/index.ts once security",
    "compliance": "tsx worker/src/index.ts once compliance",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^15.5.29",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "postcss": "^8.5.33"
  }
