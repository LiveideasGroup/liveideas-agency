# Dashboard (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public website (all safe for the browser)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
# Stripe Payment Links, one per pilot (Stripe hosts checkout; no Stripe secret in this app).
# Set each link's confirmation page to https://your-domain.com/pilot/thanks?niche=<forex|product|manual_testing>
NEXT_PUBLIC_STRIPE_PILOT_LINK_FOREX=
NEXT_PUBLIC_STRIPE_PILOT_LINK_PRODUCT=
NEXT_PUBLIC_STRIPE_PILOT_LINK_QA=

# Worker only. Never expose these to the browser or commit them.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# How outreach is signed and sent (leave SMTP empty to keep approved emails waiting)
COMPANY_NAME=LiveIdeas
SENDER_FROM="Francis at LiveIdeas <hello@your-outreach-domain.com>"
SENDER_SIGNATURE="Francis\nLiveIdeas, AI systems for growing teams\nYour registered company address"
OPT_OUT_FOOTER=If this isn't relevant, reply "no thanks" and we won't contact you again.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Security agents (worker). The worker may also hold NEXT_PUBLIC_SUPABASE_ANON_KEY so the
# Security agent can check that sign-ups are off and that the browser key is not the service key.
# Your own site, the only link the outbound guard allows besides the lead's site.
COMPANY_WEBSITE=
# The live dashboard, so the Security agent can check its security headers.
DASHBOARD_URL=
# Optional: fine-grained, read-only token for this repo (Actions + Dependabot alerts: read).
GITHUB_TOKEN=
GITHUB_REPO=LiveideasGroup/liveideas-agency
